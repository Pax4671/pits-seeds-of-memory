+// Real CPU inference with the same pinned weights, prompt and decoder used by the app.
+import {pipeline,env} from '@huggingface/transformers';
+import {MODELS,conversation,cleanReply,generationOptions} from '../web/pits-ai-core.js';
+import {writeFileSync,mkdirSync} from 'node:fs';
+import assert from 'node:assert/strict';
+const selected=process.env.PITS_AI_MODEL==='standard'?MODELS.standard:MODELS.light;const MODEL_ID=selected.id,MODEL_REVISION=selected.revision;
+env.cacheDir='.sites-runtime/ai-models';
+let last='';const start=Date.now();
+const pipe=await pipeline('text-generation',MODEL_ID,{revision:MODEL_REVISION,device:'cpu',dtype:'q8',session_options:{intraOpNumThreads:4},progress_callback:d=>{if(d.status==='initiate'||d.status==='done'){const key=d.status+':'+d.file;if(key!==last){console.log(key);last=key}}}});
+const cases=['こんにちは。君の名前は？','今日は仕事で疲れた。少し話そう。'];const results=[];
+for(const input of cases){const prompt=pipe.tokenizer.apply_chat_template(conversation([{role:'user',body:input}],'TAD'),{tokenize:false,add_generation_prompt:true,enable_thinking:false});const output=await pipe(prompt,generationOptions());const reply=cleanReply(output[0].generated_text);assert(reply.length>0,'A real response is required');assert(/[\u3040-\u30ff\u4e00-\u9fff]/.test(reply),'Japanese response required');results.push({input,reply});console.log(JSON.stringify(results.at(-1)))}
+await pipe.dispose();mkdirSync('.sites-runtime',{recursive:true});writeFileSync('.sites-runtime/real-ai-result-'+(process.env.PITS_AI_MODEL||'light')+'.json',JSON.stringify({model:MODEL_ID,revision:MODEL_REVISION,engine:'CPU q8',elapsedMs:Date.now()-start,results},null,2));console.log('REAL_MODEL_PASS');
