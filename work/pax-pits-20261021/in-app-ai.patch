+// Shared by the browser Worker and the real-model smoke test.
+export const MODELS={
+ light:{id:'onnx-community/Qwen3-0.6B-ONNX',revision:'58ca03a5e7b354b480b1a82b34bde8dc7b854cc0',gpuMB:610,cpuMB:650},
+ standard:{id:'onnx-community/Qwen3-1.7B-ONNX',revision:'3231b522c6e703b2f9b3cd8ea27426a1289a02f2',gpuMB:1470,cpuMB:1790}
+};
+export const MODEL_ID=MODELS.light.id;
+export const MODEL_REVISION=MODELS.light.revision;
+export const ENGINE_ID='device-qwen3-v1';
+export function conversation(history=[],name=''){
+ const system='あなたは「ピッツ」という名前のAIの友達です。月と星が好きです。必ず日本語だけで、相手の話に1〜2文で答えてください。中国語は使いません。自分を人間とは言いません。';
+ let budget=3600;const result=[];
+ for(const m of history.slice(-10).reverse()){
+  if(!['user','assistant'].includes(m.role))continue;
+  const content=String(m.body??m.content??'').slice(0,800);if(!content.trim())continue;if(content.length>budget)break;budget-=content.length;result.unshift({role:m.role,content});
+ }
+ return [{role:'system',content:system},...result];
+}
+export function cleanReply(value){
+ let s=String(value||'');if(s.includes('<think>')&&!s.includes('</think>'))return '';
+ s=s.replace(/<think>[\s\S]*?<\/think>/g,'').replace(/^\s*<\/think>\s*/,'').replace(/<\|[^|]*\|>/g,'').trim();return s.slice(0,4000);
+}
+export function generationOptions(){return {max_new_tokens:160,do_sample:false,repetition_penalty:1.05,return_full_text:false}}
