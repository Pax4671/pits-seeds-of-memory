+ const app={innerHTML:'',querySelector:get};let history=[],calls=[],failSave=true,generations=0;const me={id:'me',name:'TAD',approved:true,adult:true,avatar:{}};
+ const api=async(path,method='GET',body)=>{calls.push({path,method,body});if(path==='ai/history'&&method==='GET')return {messages:history};if(path==='ai/message'){history=[...history,{...body,role:'user',created:1}];return {ok:true}}if(path==='ai/local-reply'){if(failSave){failSave=false;throw new Error('network failed')}history.push({id:'reply',role:'assistant',body:body.response,reply_to:body.reply_to,created:2});return {ok:true}}};
