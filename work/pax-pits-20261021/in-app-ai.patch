+window.PitsLocalAI=(()=>{
+ let worker=null,ready=false,loading=null,active=null,onStatus=()=>{};
+ function create(){if(worker)return;worker=new Worker('/pits-ai-worker.js',{type:'module'});
+  worker.onmessage=({data})=>{
+   if(['backend','progress','ready'].includes(data.type))onStatus(data);
+   if(data.type==='ready'){ready=true;loading?.resolve();loading=null}
+   if(data.type==='chunk'&&active?.id===data.id)active.onChunk(data.text);
+   if(data.type==='complete'&&active?.id===data.id){const task=active;active=null;task.resolve(data.text)}
+   if(data.type==='error'){const error=new Error('AIを起動・実行できませんでした。通信、空き容量、ブラウザを確認してください。'+String(data.message||'').slice(0,180));ready=false;loading?.reject(error);loading=null;active?.reject(error);active=null;worker?.terminate();worker=null}
+  };worker.onerror=()=>{const e=new Error('端末内AIを読み込めませんでした。外部ブラウザで開き、通信と空き容量をご確認ください');loading?.reject(e);loading=null;active?.reject(e);active=null;worker?.terminate();worker=null;ready=false};
+ }
+ function load(status=()=>{},model='light'){onStatus=status;if(ready)return Promise.resolve();if(loading)return loading.promise;create();let resolve,reject;const promise=new Promise((a,b)=>{resolve=a;reject=b});loading={promise,resolve,reject};worker.postMessage({type:'load',model});return promise}
+ async function generate(messages,name,onChunk=()=>{}){if(!ready)throw new Error('先にAIを準備してください');if(active)throw new Error('返事を生成中です');const id=crypto.randomUUID();return new Promise((resolve,reject)=>{active={id,resolve,reject,onChunk};worker.postMessage({type:'generate',id,messages,name})})}
+ function cancel(){worker?.terminate();worker=null;ready=false;const error=new Error('生成を停止しました。送信した言葉は履歴から再試行できます');loading?.reject(error);loading=null;active?.reject(error);active=null}
+ return {load,generate,cancel,get ready(){return ready},get running(){return !!active||!!loading}};
+})();
