+test('client cancels both download and generation and can retry with a fresh worker',async()=>{const {ai,instances}=client();const loading=ai.load();ai.cancel();await assert.rejects(loading,/停止/);assert.equal(instances[0].terminated,true);const retry=ai.load();instances[1].emit({type:'ready'});await retry;const generating=ai.generate([],'');ai.cancel();await assert.rejects(generating,/停止/);assert.equal(ai.ready,false);assert.equal(ai.running,false)});
+test('AI screen submit generates a reply and saves it in the same page; retry preserves generated text',async()=>{
