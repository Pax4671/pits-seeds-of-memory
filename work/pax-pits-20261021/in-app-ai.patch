+import {MODELS,conversation,cleanReply,generationOptions} from './pits-ai-core.js';
+let generator=null,library=null,busy=false;
+const send=(type,data={})=>self.postMessage({type,...data});
+async function load(modelKey){
+ if(generator)return;
+ library=await import('./vendor/transformers-3.8.1.min.js');
+ const {env,pipeline}=library;env.allowLocalModels=false;env.useBrowserCache=true;
+ env.backends.onnx.wasm.numThreads=1;env.backends.onnx.wasm.proxy=false;
+ env.backends.onnx.wasm.wasmPaths='https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.8.1/dist/';
+ const selected=MODELS[modelKey]||MODELS.light;let device='wasm',dtype='q8';
+ try{const adapter=await self.navigator.gpu?.requestAdapter();if(adapter?.features.has('shader-f16')){device='webgpu';dtype='q4f16'}}catch{}
+ if(modelKey==='standard'&&device!=='webgpu')throw new Error('標準AIには対応GPUが必要です。軽量AIを選んでください');
+ send('backend',{device,downloadMB:device==='webgpu'?selected.gpuMB:selected.cpuMB});
+ const progress_callback=d=>{if(['progress','initiate','done'].includes(d.status))send('progress',{file:d.file,status:d.status,loaded:d.loaded,total:d.total,progress:d.progress})};
+ // Do not silently download another 600 MB if the selected backend fails.
+ generator=await pipeline('text-generation',selected.id,{revision:selected.revision,device,dtype,progress_callback});
+ send('ready',{device});
+}
+self.onmessage=async({data})=>{
+ if(busy){send('error',{id:data.id,message:'前の処理が終わるまでお待ちください'});return}
+ busy=true;
+ try{
+  if(data.type==='load'){await load(data.model);return}
+  if(data.type!=='generate')return;
+  await load(data.model);
+  const messages=conversation(data.messages,data.name);
+  const prompt=generator.tokenizer.apply_chat_template(messages,{tokenize:false,add_generation_prompt:true,enable_thinking:false});
+  let partial='';const streamer=new library.TextStreamer(generator.tokenizer,{skip_prompt:true,skip_special_tokens:true,callback_function:chunk=>{partial+=chunk;send('chunk',{id:data.id,text:cleanReply(partial)})}});
+  const output=await generator(prompt,{...generationOptions(),streamer});const reply=cleanReply(output[0]?.generated_text);
+  if(!reply)throw new Error('返事を生成できませんでした。もう一度送信してください');
+  send('complete',{id:data.id,text:reply});
+ }catch(e){generator=null;send('error',{id:data.id,message:e?.message||'AIの起動に失敗しました'})}
+ finally{busy=false}
+};
