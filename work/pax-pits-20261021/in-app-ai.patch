+const input='こんにちは。君は誰？';const prompt=p.tokenizer.apply_chat_template(conversation([{role:'user',body:input}]),{tokenize:false,add_generation_prompt:true,enable_thinking:false});const o=await p(prompt,{...generationOptions(),max_new_tokens:64});const reply=cleanReply(o[0].generated_text);assert(reply.length>0);assert(/[\u3040-\u30ff]/.test(reply));console.log(JSON.stringify({backend:'wasm',input,reply,elapsedMs:Date.now()-start}));await p.dispose();mkdirSync('.sites-runtime',{recursive:true});writeFileSync('.sites-runtime/wasm-result.json',JSON.stringify({backend:'wasm',input,reply}));console.log('WASM_MODEL_PASS');
