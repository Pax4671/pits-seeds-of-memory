+import test from 'node:test';import assert from 'node:assert/strict';import {readFileSync,mkdtempSync,rmSync} from 'node:fs';import {tmpdir} from 'node:os';import {join} from 'node:path';import vm from 'node:vm';import {decryptBackup,restoreIsolated} from '../scripts/restore-isolated.mjs';
+const sandbox={window:{},crypto:globalThis.crypto,TextEncoder,Uint8Array,btoa,setInterval,clearInterval};vm.runInNewContext(readFileSync('web/safety.js','utf8'),sandbox);
+test('browser encryption and offline decrypt/restore roundtrip, wrong password and tampering fail',async()=>{const data={format:'pits-admin-backup-v1',created:Date.now(),tables:{members:[],rooms:[],ai_messages:[]},assets:[]};const encrypted=await sandbox.window.PitsSafety.seal(data,'a test passphrase 123');assert(!JSON.stringify(encrypted).includes('members'));assert.deepEqual(await decryptBackup(encrypted,'a test passphrase 123'),data);await assert.rejects(decryptBackup(encrypted,'wrong'));await assert.rejects(decryptBackup({...encrypted,ciphertext:'AAAA'+encrypted.ciphertext.slice(4)},'a test passphrase 123'));const dir=mkdtempSync(join(tmpdir(),'pits-restore-'));try{const result=restoreIsolated(data,join(dir,'new'));assert.equal(result.productionModified,false);assert.equal(result.tables.members,0);assert.throws(()=>restoreIsolated(data,join(dir,'new')))}finally{rmSync(dir,{recursive:true,force:true})}});
