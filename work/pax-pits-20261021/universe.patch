diff --git a/scripts/restore-isolated.mjs b/scripts/restore-isolated.mjs
new file mode 100644
index 0000000..bc39a93
--- /dev/null
+++ b/scripts/restore-isolated.mjs
@@ -0,0 +1,31 @@
+// Offline restore verifier. Never connects to the deployed Site or writes a production DB.
+import {DatabaseSync} from 'node:sqlite';
+import {readFileSync,readdirSync,mkdirSync,writeFileSync,existsSync} from 'node:fs';
+import {resolve,join} from 'node:path';
+import {webcrypto} from 'node:crypto';
+import {createInterface} from 'node:readline/promises';
+export async function decryptBackup(envelope,password){
+ if(envelope.format!=='pits-encrypted-backup-v1'||envelope.iterations!==310000)throw new Error('Unsupported encrypted backup');
+ const salt=Buffer.from(envelope.salt,'base64'),iv=Buffer.from(envelope.iv,'base64');if(salt.length!==16||iv.length!==12)throw new Error('Invalid crypto parameters');
+ const base=await webcrypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveKey']);
+ const key=await webcrypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:310000,hash:'SHA-256'},base,{name:'AES-GCM',length:256},false,['decrypt']);
+ return JSON.parse(new TextDecoder().decode(await webcrypto.subtle.decrypt({name:'AES-GCM',iv},key,Buffer.from(envelope.ciphertext,'base64'))));
+}
+export function restoreIsolated(data,directory){
+ if(data.format!=='pits-admin-backup-v1'||!Array.isArray(data.assets))throw new Error('Invalid snapshot');
+ const out=resolve(directory);if(existsSync(out))throw new Error('Choose a new empty output path; existing paths are never overwritten');mkdirSync(out,{recursive:true,mode:0o700});
+ const db=new DatabaseSync(join(out,'isolated.sqlite'));
+ for(const file of readdirSync('drizzle').filter(n=>n.endsWith('.sql')).sort())db.exec(readFileSync(join('drizzle',file),'utf8'));
+ const valid=new Set(db.prepare("SELECT name FROM sqlite_master WHERE type='table'").all().map(x=>x.name));
+ db.exec('BEGIN');try{for(const [name,rows] of Object.entries(data.tables)){if(!valid.has(name))throw new Error('Unknown table');const columns=new Set(db.prepare('PRAGMA table_info('+name+')').all().map(x=>x.name));for(const row of rows){const keys=Object.keys(row);if(keys.some(k=>!columns.has(k)))throw new Error('Unknown column');db.prepare('INSERT INTO '+name+'('+keys.join(',')+') VALUES('+keys.map(()=>'?').join(',')+')').run(...Object.values(row))}}db.exec('COMMIT')}catch(e){db.exec('ROLLBACK');db.close();throw e}
+ const tables=Object.fromEntries(Object.keys(data.tables).map(t=>[t,db.prepare('SELECT count(*) AS n FROM '+t).get().n]));db.close();
+ mkdirSync(join(out,'avatars'),{mode:0o700});for(const a of data.assets){if(!/^avatars\/[a-f0-9-]{36}$/.test(a.key))throw new Error('Unsafe asset path');writeFileSync(join(out,a.key),Buffer.from(a.body,'base64'),{mode:0o600,flag:'wx'})}
+ writeFileSync(join(out,'asset-metadata.json'),JSON.stringify(data.assets.map(({body,...a})=>a)),{mode:0o600,flag:'wx'});
+ return {tables,assets:data.assets.length,productionModified:false};
+}
+if(process.argv[1]&&resolve(process.argv[1])===resolve(new URL(import.meta.url).pathname)){
+ const [input,out]=process.argv.slice(2);if(!input||!out)throw new Error('Usage: node scripts/restore-isolated.mjs encrypted.json NEW_OUTPUT_DIRECTORY');
+ // Read passphrase from stdin; never pass it in process arguments or log it.
+ const lines=createInterface({input:process.stdin,output:undefined,terminal:false});let password='';for await(const line of lines){password=line;lines.close();break}
+ console.log(JSON.stringify(restoreIsolated(await decryptBackup(JSON.parse(readFileSync(input,'utf8')),password),out)));
+}
