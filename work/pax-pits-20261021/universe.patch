+CREATE UNIQUE INDEX `ai_messages_reply_to_unique` ON `ai_messages` (`reply_to`);--> statement-breakpoint
+CREATE INDEX `ai_owner_time` ON `ai_messages` (`owner`,`created`);--> statement-breakpoint
+CREATE TABLE `audit_log` (
+	`id` text PRIMARY KEY NOT NULL,
+	`actor` text NOT NULL,
+	`action` text NOT NULL,
+	`target` text NOT NULL,
+	`note` text DEFAULT '' NOT NULL,
+	`created` integer NOT NULL
+);
+--> statement-breakpoint
+ALTER TABLE `members` ADD `approved` integer DEFAULT 0 NOT NULL;
