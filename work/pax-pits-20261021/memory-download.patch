+CREATE TABLE `ai_companions` (
+	`owner` text PRIMARY KEY NOT NULL,
+	`name` text DEFAULT 'ピッツ' NOT NULL,
+	`tone` text DEFAULT 'gentle' NOT NULL,
+	`interests` text DEFAULT '月と星' NOT NULL,
+	`goal` text DEFAULT '' NOT NULL,
+	`updated` integer NOT NULL
+);
+--> statement-breakpoint
+CREATE TABLE `ai_memories` (
+	`id` text PRIMARY KEY NOT NULL,
+	`owner` text NOT NULL,
+	`kind` text NOT NULL,
+	`body` text NOT NULL,
+	`source_message` text,
+	`source_url` text DEFAULT '' NOT NULL,
+	`created` integer NOT NULL,
+	`updated` integer NOT NULL
+);
+--> statement-breakpoint
+CREATE UNIQUE INDEX `ai_memories_source_message_unique` ON `ai_memories` (`source_message`);--> statement-breakpoint
+CREATE INDEX `ai_memory_owner` ON `ai_memories` (`owner`,`updated`);
