+// Actual model inference. Network downloads public pinned weights, never calls an AI API.
+import {pipeline,env} from '@huggingface/transformers';
+import {MODELS,conversation,cleanReply,generationOptions} from '../web/pits-ai-core.js';
+import {mkdirSync,writeFileSync} from 'node:fs';
+env.cacheDir='.sites-runtime/ai-models';const model=MODELS.light;let last='';
+const pipe=await pipeline('text-generation',model.id,{revision:model.revision,device:'cpu',dtype:'q8',session_options:{intraOpNumThreads:4},progress_callback:d=>{if(['initiate','done'].includes(d.status)&&last!==d.status+':'+d.file){last=d.status+':'+d.file;console.log(last)}}});
+const knowledge={companion:{name:'ルナ',tone:'gentle',interests:'月と星',goal:'一緒に創作を楽しむ'},memories:[{kind:'fact',body:'TADは写真が好きです。'},{kind:'experience',body:'TADと一緒に星の写真について話しました。'}]};
+const results=[];for(const input of ['あなたの名前は何？','私の好きなこと、覚えている？']){
+ const prompt=pipe.tokenizer.apply_chat_template(conversation([{role:'user',body:input}],'TAD',knowledge),{tokenize:false,add_generation_prompt:true,enable_thinking:false});const result=await pipe(prompt,generationOptions());const reply=cleanReply(result[0].generated_text);results.push({input,reply});console.log(JSON.stringify(results.at(-1)));
+}
+await pipe.dispose();mkdirSync('.sites-runtime',{recursive:true});writeFileSync('.sites-runtime/memory-inference.json',JSON.stringify({model:model.id,revision:model.revision,backend:'native CPU q8; not a mobile browser',results},null,2));
+if(!results[0].reply.includes('ルナ')||!results[1].reply.includes('写真'))throw new Error('Model did not reflect name and memory; see recorded real replies');console.log('NAME_AND_MEMORY_KEYWORD_CHECK_PASS; semantic quality requires review');
