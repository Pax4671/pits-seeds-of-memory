+// Public model files only. Never store profile, conversations or credentials here.
+import {MODELS} from './pits-ai-core.js';
+export const CACHE='pits-model-parts-v1',CHUNK=32*1024*1024;
+const roots={light:{'config.json':912,'generation_config.json':219,'tokenizer_config.json':10369,'tokenizer.json':9117040},standard:{'config.json':943,'generation_config.json':219,'tokenizer_config.json':10369,'tokenizer.json':9117040}};
+const weights={light:{q4f16:569789750,q8:617687575},standard:{q4f16:1426069098}};
+export function planFor(model='light',dtype='q8'){
+ if(!MODELS[model]||!weights[model][dtype])throw new Error('このAIと端末の組み合わせには対応していません');
+ const spec=MODELS[model],sizes={...roots[model],['onnx/model_'+(dtype==='q8'?'quantized':dtype)+'.onnx']:weights[model][dtype]};
+ const files=Object.entries(sizes).map(([path,size])=>{const url='https://huggingface.co/'+spec.id+'/resolve/'+spec.revision+'/'+path;return {url,path,size,parts:Array.from({length:Math.ceil(size/CHUNK)},(_,i)=>{const start=i*CHUNK,end=Math.min(size-1,start+CHUNK-1);return {url,path,start,end,fileSize:size,size:end-start+1,range:size>CHUNK,key:'https://pax-pits-universe.tad-world.chatgpt.site/.pits-ai-cache/'+spec.revision+'/'+encodeURIComponent(path)+'?part='+i}})}});
+ return {id:'pits-'+model+'-'+dtype+'-'+spec.revision,model,dtype,files,total:files.reduce((n,f)=>n+f.size,0)};
+}
+export function allPlans(){return [planFor('light','q8'),planFor('light','q4f16'),planFor('standard','q4f16')]}
+export async function legacyFile(url){try{return await (await caches.open('transformers-cache')).match(url)}catch{return undefined}}
+export async function missingParts(plan){const cache=await caches.open(CACHE),missing=[];let loaded=0;
+ for(const f of plan.files){if(await legacyFile(f.url)){loaded+=f.size;continue}for(const p of f.parts){if(await cache.match(p.key))loaded+=p.size;else missing.push(p)}}return {missing,loaded};
+}
+export function requestFor(part){return new Request(part.url,{mode:'cors',credentials:'omit',headers:part.range?{Range:'bytes='+part.start+'-'+part.end}:{}})}
+export async function savePart(part,response){
+ if(part.range){if(response.status!==206||response.headers.get('content-range')!=='bytes '+part.start+'-'+part.end+'/'+part.fileSize)throw new Error('分割ダウンロードの応答を確認できません。保存済みの分は保持します')}
+ else if(response.status!==200)throw new Error('AIファイルを取得できません（'+response.status+'）');
+ if(!response.body||response.type==='opaque')throw new Error('AIファイルを読み取れません');
+ // Count bytes while streaming. A truncated body must never become a completed part.
+ let received=0;const stream=response.body.pipeThrough(new TransformStream({transform(chunk,controller){received+=chunk.byteLength;if(received>part.size)throw new Error('AIファイルのサイズが一致しません');controller.enqueue(chunk)},flush(){if(received!==part.size)throw new Error('ダウンロードが途中で止まりました')}}));
+ await (await caches.open(CACHE)).put(part.key,new Response(stream,{headers:{'content-type':'application/octet-stream','content-length':String(part.size)}}));
+}
+export function partFor(request){const url=typeof request==='string'?request:request.url,range=typeof request==='string'?null:request.headers.get('range');return allPlans().flatMap(p=>p.files.flatMap(f=>f.parts)).find(p=>p.url===url&&(p.range?'bytes='+p.start+'-'+p.end:null)===range)}
+export async function modelMatch(key){const url=typeof key==='string'?key:key.url;const file=allPlans().flatMap(p=>p.files).find(f=>f.url===url);if(!file)return undefined;const old=await legacyFile(url);if(old)return old;
+ const cache=await caches.open(CACHE);for(const p of file.parts)if(!await cache.match(p.key))return undefined;
+ return joinFile(file,cache);
+}
+export function joinFile(file,cache){
+ let i=0,reader=null;const stream=new ReadableStream({async pull(controller){try{while(true){if(!reader){if(i===file.parts.length){controller.close();return}const response=await cache.match(file.parts[i++].key);if(!response)throw new Error('保存済みAIが削除されました。準備し直してください');reader=response.body.getReader()}const {value,done}=await reader.read();if(done){reader=null;continue}controller.enqueue(value);return}}catch(e){controller.error(e)}},async cancel(){await reader?.cancel()}});
+ return new Response(stream,{headers:{'content-length':String(file.size),'content-type':file.path.endsWith('.json')?'application/json':'application/octet-stream'}});
+}
+export const modelCache={match:modelMatch,async put(key,response){if(response.status===200)await (await caches.open('transformers-cache')).put(key,response)}};
+export async function storeBackground(registration){const records=await registration.matchAll();let saved=0;
+ for(const record of records){const part=partFor(record.request);if(!part)continue;try{await savePart(part,await record.responseReady);saved++}catch{}}
+ const cache=await caches.open(CACHE);await cache.put('https://pax-pits-universe.tad-world.chatgpt.site/.pits-ai-cache/jobs/'+registration.id,new Response(JSON.stringify({id:registration.id,result:registration.result,saved,at:Date.now()}),{headers:{'content-type':'application/json'}}));return saved;
+}
+
+export async function downloadParts(plan,status=()=>{},signal,fetcher=fetch){
+ const {missing,loaded}=await missingParts(plan);let complete=loaded;
+ for(const part of missing){if(signal?.aborted)throw new Error('ダウンロードを中止しました。保存済みの分から再開できます');await savePart(part,await fetcher(requestFor(part),{signal}));complete+=part.size;status({type:'download-progress',loaded:complete,total:plan.total,background:false})}
+}
